                                 ssl_client_hello_type_t type);
 
+// ssl_clienthello_psk_len returns the length of the pre_shared_key extension
+// a ClientHello of `type` carries, or zero if it carries none.
+size_t ssl_clienthello_psk_len(const SSL_HANDSHAKE *hs,
+                               ssl_client_hello_type_t type);
