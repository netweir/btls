From: James Conway <148910373+jamesconwaydev@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:00:00 -0700
Subject: [PATCH 11/11] boringssl: write the ClientHelloInner as NSS does

NSS (Firefox) and BoringSSL build ClientHelloInner differently:

- NSS writes the encrypted_client_hello marker before every other
  extension. BoringSSL writes it where the extension order puts it.
- NSS offers the ClientHelloOuter's cipher suites, TLS 1.2 ones
  included. BoringSSL offers only TLS 1.3 ones.
- NSS compresses delegated_credentials and record_size_limit into
  ech_outer_extensions, as they are the same in both ClientHellos. The
  record-size-limit and delegated-credentials patches wrote them
  uncompressed.

- NSS's GREASE ECH draws AES-128-GCM or ChaCha20-Poly1305 at random,
  and its payload is as long as the EncodedClientHelloInner would be,
  padded for a maximum_name_length of 100 (tls13_MaybeGreaseEch).
  BoringSSL's takes AES-128-GCM wherever it has AES hardware, and a
  random length.

SSL_CTX_set_ech_inner_like_nss turns on the first two and the last,
and both extensions are now compressible, as BoringSSL's own extensions
are when they match. Recorded against Firefox 160.0.1 in
netweir/netweir's profiles/firefox-160-macos.ech.capture.json.
---
diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5610,6 +5610,22 @@
 // send record size limit extension.
 OPENSSL_EXPORT void SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
 
+// SSL_CTX_set_ech_inner_like_nss configures whether connections from |ctx|
+// write their ClientHelloInner as NSS does: the encrypted_client_hello
+// marker first, and the same cipher suites as the ClientHelloOuter, TLS 1.2
+// ones included. By default the marker goes where the extension order puts
+// it and the ClientHelloInner offers only TLS 1.3 cipher suites. It also
+// makes GREASE ECH NSS's: AES-128-GCM or ChaCha20-Poly1305 drawn at random,
+// and a payload as long as the EncodedClientHelloInner would be, padded for
+// a maximum_name_length of 100.
+OPENSSL_EXPORT void SSL_CTX_set_ech_inner_like_nss(SSL_CTX *ctx, int enabled);
+
+// SSL_set_ech_padding_name_len sets the length of the name |ssl| connects
+// to, for when it sends no server_name, as for an IP address. With
+// |SSL_CTX_set_ech_inner_like_nss|, GREASE ECH pads for that name as NSS
+// pads for the URL's host (tls13_PadChInner). Zero, the default, is no name.
+OPENSSL_EXPORT void SSL_set_ech_padding_name_len(SSL *ssl, size_t len);
+
 // SSL_CTX_set_record_size_limit configures whether sockets on |ctx| should
 // send record size limit extension.
 OPENSSL_EXPORT void SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit);
diff --git a/ssl/encrypted_client_hello.cc b/ssl/encrypted_client_hello.cc
--- a/ssl/encrypted_client_hello.cc
+++ b/ssl/encrypted_client_hello.cc
@@ -729,6 +729,51 @@
   return value % (max - min + 1) + min;
 }
 
+// The length NSS gives a GREASE ECH payload's plaintext (tls13_MaybeGreaseEch
+// in lib/ssl/tls13ech.c): the EncodedClientHelloInner this ClientHello would
+// have, padded by tls13_PadChInner as for a configuration whose
+// maximum_name_length is 100, NSS's default greaseEchSize, which Firefox
+// keeps (security.tls.ech.grease_size).
+static bool grease_ech_plaintext_len_like_nss(SSL_HANDSHAKE *hs,
+                                              size_t *out_len) {
+  SSLImpl *const ssl = hs->ssl;
+  // A real ClientHelloInner's pre_shared_key has binders over a transcript
+  // GREASE has none of, so it's left out here. NSS copies the
+  // ClientHelloOuter's pre_shared_key into the one it measures instead, so
+  // that one's length is added back.
+  const size_t psk_len =
+      ssl_clienthello_psk_len(hs, ssl_client_hello_unencrypted);
+  Vector<SSLPreSharedKey> psks;
+  std::swap(psks, hs->pre_shared_keys);
+  ScopedCBB body, encoded;
+  bool ok = CBB_init(body.get(), 512) && CBB_init(encoded.get(), 256) &&
+            ssl_write_client_hello_without_extensions(
+                hs, body.get(), ssl_client_hello_inner,
+                /*empty_session_id=*/false) &&
+            ssl_write_client_hello_without_extensions(
+                hs, encoded.get(), ssl_client_hello_inner,
+                /*empty_session_id=*/true) &&
+            ssl_add_clienthello_tlsext(hs, body.get(), encoded.get(),
+                                       ssl_client_hello_inner);
+  std::swap(psks, hs->pre_shared_keys);
+  if (!ok) {
+    return false;
+  }
+  // NSS pads for the URL's host, which it has whether or not it sends
+  // server_name for it (none goes to an IP address).
+  const size_t kGreaseMaxNameLen = 100;
+  const size_t name_len = ssl->hostname ? strlen(ssl->hostname.get())
+                                        : hs->config->ech_padding_name_len;
+  size_t padding_len = 0;
+  if (name_len <= kGreaseMaxNameLen) {
+    padding_len = kGreaseMaxNameLen - name_len;
+  }
+  size_t len = CBB_len(encoded.get()) + psk_len;
+  padding_len += 31 - ((len + padding_len - 1) % 32);
+  *out_len = len + padding_len;
+  return true;
+}
+
 static bool setup_ech_grease(SSL_HANDSHAKE *hs) {
   assert(!hs->selected_ech_config);
   if (hs->max_version < TLS1_3_VERSION || !hs->config->ech_grease_enabled) {
@@ -741,6 +786,17 @@
                               : EVP_has_aes_hardware();
   const EVP_HPKE_AEAD *aead =
       has_aes_hw ? EVP_hpke_aes_128_gcm() : EVP_hpke_chacha20_poly1305();
+  size_t nss_plaintext_len = 0;
+  if (hs->config->ech_inner_like_nss) {
+    // NSS draws AES-128-GCM or ChaCha20-Poly1305 at random for each GREASE
+    // ECH extension, whatever the hardware (tls13_MaybeGreaseEch).
+    uint8_t coin;
+    if (!RAND_bytes(&coin, 1) ||
+        !grease_ech_plaintext_len_like_nss(hs, &nss_plaintext_len)) {
+      return false;
+    }
+    aead = (coin & 1) ? EVP_hpke_aes_128_gcm() : EVP_hpke_chacha20_poly1305();
+  }
   static_assert(ssl_grease_ech_config_id < sizeof(hs->grease_seed),
                 "hs->grease_seed is too small");
   uint8_t config_id = hs->grease_seed[ssl_grease_ech_config_id];
@@ -765,7 +821,10 @@
   // estimate maximum_name_length to be between 32 and 100 bytes. Then round up
   // to a multiple of 32, to match RFC 9849, section 6.1.3.
   const size_t payload_len =
-      32 * random_size(128 / 32, 224 / 32) + aead_overhead(aead);
+      (hs->config->ech_inner_like_nss
+           ? nss_plaintext_len
+           : 32 * random_size(128 / 32, 224 / 32)) +
+      aead_overhead(aead);
   bssl::ScopedCBB cbb;
   CBB enc_cbb, payload_cbb;
   uint8_t *payload;
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -590,6 +590,10 @@
                                     CBB *out_compressible,
                                     ssl_client_hello_type_t type) {
   if (type == ssl_client_hello_inner) {
+    // Written first in |ssl_add_clienthello_tlsext_inner| instead.
+    if (hs->config->ech_inner_like_nss) {
+      return true;
+    }
     if (!CBB_add_u16(out, TLSEXT_TYPE_encrypted_client_hello) ||
         !CBB_add_u16(out, /* length */ 1) ||
         !CBB_add_u8(out, ECH_CLIENT_INNER)) {
@@ -2009,6 +2013,11 @@
   return ret;
 }
 
+size_t ssl_clienthello_psk_len(const SSL_HANDSHAKE *hs,
+                               ssl_client_hello_type_t type) {
+  return ext_pre_shared_key_clienthello_length(hs, type);
+}
+
 // ext_pre_shared_key_add_clienthello writes a pre_shared_key extension to
 // `out_extensions` and flushes `out_client_hello`, invalidating
 // `out_extensions`. `out_extensions` must be a child of `out_client_hello`.
@@ -3328,8 +3337,9 @@
   const Array<uint16_t> &signature_hash_algorithms =
       hs->config->delegated_credentials;
 
-  if (!CBB_add_u16(out, TLSEXT_TYPE_delegated_credential) ||
-      !CBB_add_u16_length_prefixed(out, &contents) ||
+  // The same in both ClientHellos, so it can be compressed.
+  if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
       !CBB_add_u16_length_prefixed(&contents, &data)) {
     return false;
   }
@@ -3340,7 +3350,7 @@
     }
   }
 
-  if (!CBB_flush(out)) {
+  if (!CBB_flush(out_compressible)) {
     return false;
   }
 
@@ -3906,9 +3916,10 @@
   if (hs->config->record_size_limit != 0) {
     CBB data;
     const uint16_t data_ = hs->config->record_size_limit;
-    if (!CBB_add_u16(out, TLSEXT_TYPE_record_size_limit) ||
-        !CBB_add_u16_length_prefixed(out, &data) ||
-        !CBB_add_u16(&data, data_) || !CBB_flush(out)) {
+    // The same in both ClientHellos, so it can be compressed.
+    if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_record_size_limit) ||
+        !CBB_add_u16_length_prefixed(out_compressible, &data) ||
+        !CBB_add_u16(&data, data_) || !CBB_flush(out_compressible)) {
       return false;
     }
   }
@@ -4588,6 +4599,21 @@
   }
 
   hs->inner_extensions_sent = 0;
+
+  // NSS writes the encrypted_client_hello marker before every other
+  // extension of the ClientHelloInner.
+  if (hs->config->ech_inner_like_nss) {
+    uint32_t ech_index;
+    if (tls_extension_find(&ech_index, TLSEXT_TYPE_encrypted_client_hello) ==
+            nullptr ||
+        !CBB_add_u16(&extensions, TLSEXT_TYPE_encrypted_client_hello) ||
+        !CBB_add_u16(&extensions, /* length */ 1) ||
+        !CBB_add_u8(&extensions, ECH_CLIENT_INNER)) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    hs->inner_extensions_sent |= (1u << ech_index);
+  }
 
   if (ssl->ctx->grease_enabled) {
     // Add a fake empty extension. See RFC 8701. This always matches
diff --git a/ssl/handshake_client.cc b/ssl/handshake_client.cc
--- a/ssl/handshake_client.cc
+++ b/ssl/handshake_client.cc
@@ -163,7 +163,10 @@
     }
   }
 
-  if (hs->min_version < TLS1_3_VERSION && type != ssl_client_hello_inner) {
+  // NSS offers the ClientHelloOuter's cipher suites in the ClientHelloInner
+  // too.
+  if (hs->min_version < TLS1_3_VERSION &&
+      (type != ssl_client_hello_inner || hs->config->ech_inner_like_nss)) {
     bool any_enabled = false;
     for (const SSL_CIPHER *cipher : SSL_get_ciphers(ssl)) {
       // Skip disabled ciphers
diff --git a/ssl/internal.h b/ssl/internal.h
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3585,6 +3585,14 @@
   // record_size_limit is whether to send record size limit extension.
   uint16_t record_size_limit = 0;
 
+  // ech_inner_like_nss is whether the ClientHelloInner is written as NSS
+  // writes it. See |SSL_CTX_set_ech_inner_like_nss|.
+  bool ech_inner_like_nss = false;
+
+  // ech_padding_name_len is the length of the name connected to when no
