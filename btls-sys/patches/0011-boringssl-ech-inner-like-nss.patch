From: James Conway <148910373+jamesconwaydev@users.noreply.github.com>
Date: Wed, 25 Nov 2026 16:00:00 -0700
Subject: [PATCH 11/11] boringssl: write the ClientHelloInner as NSS does

NSS (Firefox) and BoringSSL build ClientHelloInner differently:

- NSS writes the encrypted_client_hello marker before every other
  extension. BoringSSL writes it where the extension order puts it.
- NSS offers the ClientHelloOuter's cipher suites, TLS 1.2 ones
  included. BoringSSL offers only TLS 1.3 ones.
- NSS compresses delegated_credentials and record_size_limit into
  ech_outer_extensions, as they are the same in both ClientHellos. The
  record-size-limit and delegated-credentials patches wrote them
  uncompressed.

SSL_CTX_set_ech_inner_like_nss turns on the first two, and both
extensions are now compressible, as BoringSSL's own extensions are
when they match. Recorded against Firefox 160.0.1 in
netweir/netweir's profiles/firefox-160-macos.ech.capture.json.
---
diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5610,6 +5610,13 @@
 // send record size limit extension.
 OPENSSL_EXPORT void SSL_set_record_size_limit(SSL *ssl, uint16_t limit);
 
+// SSL_CTX_set_ech_inner_like_nss configures whether connections from |ctx|
+// write their ClientHelloInner as NSS does: the encrypted_client_hello
+// marker first, and the same cipher suites as the ClientHelloOuter, TLS 1.2
+// ones included. By default the marker goes where the extension order puts
+// it and the ClientHelloInner offers only TLS 1.3 cipher suites.
+OPENSSL_EXPORT void SSL_CTX_set_ech_inner_like_nss(SSL_CTX *ctx, int enabled);
+
 // SSL_CTX_set_record_size_limit configures whether sockets on |ctx| should
 // send record size limit extension.
 OPENSSL_EXPORT void SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit);
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -590,6 +590,10 @@
                                     CBB *out_compressible,
                                     ssl_client_hello_type_t type) {
   if (type == ssl_client_hello_inner) {
+    // Written first in |ssl_add_clienthello_tlsext_inner| instead.
+    if (hs->config->ech_inner_like_nss) {
+      return true;
+    }
     if (!CBB_add_u16(out, TLSEXT_TYPE_encrypted_client_hello) ||
         !CBB_add_u16(out, /* length */ 1) ||
         !CBB_add_u8(out, ECH_CLIENT_INNER)) {
@@ -3328,8 +3332,9 @@
   const Array<uint16_t> &signature_hash_algorithms =
       hs->config->delegated_credentials;
 
-  if (!CBB_add_u16(out, TLSEXT_TYPE_delegated_credential) ||
-      !CBB_add_u16_length_prefixed(out, &contents) ||
+  // The same in both ClientHellos, so it can be compressed.
+  if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_delegated_credential) ||
+      !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
       !CBB_add_u16_length_prefixed(&contents, &data)) {
     return false;
   }
@@ -3340,7 +3345,7 @@
     }
   }
 
-  if (!CBB_flush(out)) {
+  if (!CBB_flush(out_compressible)) {
     return false;
   }
 
@@ -3906,9 +3911,10 @@
   if (hs->config->record_size_limit != 0) {
     CBB data;
     const uint16_t data_ = hs->config->record_size_limit;
-    if (!CBB_add_u16(out, TLSEXT_TYPE_record_size_limit) ||
-        !CBB_add_u16_length_prefixed(out, &data) ||
-        !CBB_add_u16(&data, data_) || !CBB_flush(out)) {
+    // The same in both ClientHellos, so it can be compressed.
+    if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_record_size_limit) ||
+        !CBB_add_u16_length_prefixed(out_compressible, &data) ||
+        !CBB_add_u16(&data, data_) || !CBB_flush(out_compressible)) {
       return false;
     }
   }
@@ -4588,6 +4594,21 @@
   }
 
   hs->inner_extensions_sent = 0;
+
+  // NSS writes the encrypted_client_hello marker before every other
+  // extension of the ClientHelloInner.
+  if (hs->config->ech_inner_like_nss) {
+    uint32_t ech_index;
+    if (tls_extension_find(&ech_index, TLSEXT_TYPE_encrypted_client_hello) ==
+            nullptr ||
+        !CBB_add_u16(&extensions, TLSEXT_TYPE_encrypted_client_hello) ||
+        !CBB_add_u16(&extensions, /* length */ 1) ||
+        !CBB_add_u8(&extensions, ECH_CLIENT_INNER)) {
+      OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+      return false;
+    }
+    hs->inner_extensions_sent |= (1u << ech_index);
+  }
 
   if (ssl->ctx->grease_enabled) {
     // Add a fake empty extension. See RFC 8701. This always matches
diff --git a/ssl/handshake_client.cc b/ssl/handshake_client.cc
--- a/ssl/handshake_client.cc
+++ b/ssl/handshake_client.cc
@@ -163,7 +163,10 @@
     }
   }
 
-  if (hs->min_version < TLS1_3_VERSION && type != ssl_client_hello_inner) {
+  // NSS offers the ClientHelloOuter's cipher suites in the ClientHelloInner
+  // too.
+  if (hs->min_version < TLS1_3_VERSION &&
+      (type != ssl_client_hello_inner || hs->config->ech_inner_like_nss)) {
     bool any_enabled = false;
     for (const SSL_CIPHER *cipher : SSL_get_ciphers(ssl)) {
       // Skip disabled ciphers
diff --git a/ssl/internal.h b/ssl/internal.h
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -3585,6 +3585,10 @@
   // record_size_limit is whether to send record size limit extension.
   uint16_t record_size_limit = 0;
 
+  // ech_inner_like_nss is whether the ClientHelloInner is written as NSS
+  // writes it. See |SSL_CTX_set_ech_inner_like_nss|.
+  bool ech_inner_like_nss = false;
+
   // delegated_credentials, if not empty, is the set of signature algorithms
   // supported by the client.
   Array<uint16_t> delegated_credentials;
@@ -4268,6 +4272,10 @@
 
   // record_size_limit is whether to send record size limit extension.
   uint16_t record_size_limit = 0;
+
+  // ech_inner_like_nss is whether the ClientHelloInner is written as NSS
+  // writes it. See |SSL_CTX_set_ech_inner_like_nss|.
+  bool ech_inner_like_nss = false;
 
   // delegated_credentials, if not empty, is the set of signature algorithms
   // supported by the client.
diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -585,6 +585,7 @@
   ssl->config->handoff = ctx_impl->handoff;
   ssl->quic_method = ctx_impl->quic_method;
   ssl->config->record_size_limit = ctx_impl->record_size_limit;
+  ssl->config->ech_inner_like_nss = ctx_impl->ech_inner_like_nss;
   ssl->config->preserve_tls13_cipher_list =
       ctx_impl->preserve_tls13_cipher_list;
 
@@ -2361,6 +2362,10 @@
 
 void SSL_CTX_set_record_size_limit(SSL_CTX *ctx, uint16_t limit) {
   FromOpaque(ctx)->record_size_limit = limit;
+}
+
+void SSL_CTX_set_ech_inner_like_nss(SSL_CTX *ctx, int enabled) {
+  FromOpaque(ctx)->ech_inner_like_nss = !!enabled;
 }
 
 void SSL_CTX_set_preserve_tls13_cipher_list(SSL_CTX *ctx,
